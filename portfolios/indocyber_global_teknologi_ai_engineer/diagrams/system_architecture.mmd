flowchart LR
    C["Client (reviewer)"] --> A["FastAPI edge (budget check)"]
    A --> L["Budget ledger (Postgres)"]
    A --> P["Planner (LLM, untrusted)"]
    P --> S["Stop controller (cap or no gain)"]
    S -->|continue| T["Tool registry (3 tools)"]
    T --> R["Retrieval (pgvector + lexical)"]
    R --> O["Page text (pre-extracted)"]
    T --> L
    S -->|stop| V["Verifier (deterministic spans)"]
    V -->|verified| C
    V -->|no span| X["Refusal (insufficient evidence)"]
    X --> C
    L --> E["Trace store (JSONL)"]
    V --> E
