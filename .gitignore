# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Machine-specific puppeteer config (auto-generated, contains a local path)
tools/.puppeteer-config.json

# Environment & Secrets
.env
.env.*
*.env
*.pem
*.key
secrets.*

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Candidate personal documents (prevents leaking private data to the remote repo)
documents/cv/*
!documents/cv/.gitkeep
documents/linkedin/*
!documents/linkedin/.gitkeep
documents/transcripts/*
!documents/transcripts/.gitkeep
documents/past_projects/*
!documents/past_projects/.gitkeep

# Scrape cache (regeneratable, personal: contains job URLs and raw page text)
job_scraper/*
!job_scraper/.gitkeep

# Mirror produced by setup_cli_links.sh (regeneratable from .claude/commands)
.opencode/

# Generated blueprint artifacts (keep the .md sources, drop regenerated output)
portfolios/**/Blueprint_Final.pdf
portfolios/**/Blueprint_Final.md
portfolios/**/diagrams/*.png

# Local test scratch folders (any _-prefixed folder under these roots)
portfolios/_*/
job_scraper/_*/

# Personal build history (mechanism memory, regenerable from the tracker)
portfolios/_history.json

# Private portfolios (candidate's own work, not for public repo)
portfolios/kredivo_group_data_scientist_ai_collection/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Log & temp
*.log
*.tmp
*.bak

# Local agent harness scratch (playwright snapshots)
.playwright-mcp/

# One-off build spec, superseded by CLAUDE.md + skills
PLAN.md
